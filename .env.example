API_PROXY_TARGET=http://localhost:8888
# Public site key only. Required for production login; secret stays in backend.
VITE_TURNSTILE_SITE_KEY=
# Must match GOOGLE_CLIENT_ID on the backend. Public OAuth client ID only.
VITE_GOOGLE_CLIENT_ID=
# Development bootstrap only; backend AUTH_SIGNUP_ENABLED must also be true.
VITE_AUTH_SIGNUP_ENABLED=false
